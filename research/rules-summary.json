      "delta_decay_per_shorter_len": 8,
      "delta_floor": 10,
      "enabled": true
    },
    "scoring_weights": {
      "case_pattern_bonus": 3,
      "dictionary_never_correct_raw": -10000,
      "exact_common_word": 90,
      "exact_phrase_start_word": 24,
      "exact_seed_pair": 120,
      "frequent_token_bonus": 15,
      "has_language_vowel": 8,
      "impossible_pattern": -120,
      "layout_suspicion": 12,
      "missing_language_vowel_len_4_plus": -26,
      "protected_pattern_raw": -10000,
      "rare_bigram": -10,
      "rare_pattern": -34,
      "rare_trigram": -16,
      "strong_bigram": 3,
      "strong_trigram": 5,
      "strong_word_end": 9,
      "strong_word_start": 9,
      "weak_word_end": 4,
      "weak_word_start": 4
    }
  },
