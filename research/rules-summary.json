  "metadata": {
    "languages": [
      "ru",
      "en"
    ],
    "mode": "conservative_auto_plus_manual_override",
    "notes": [
      "Do not use this file as a keystroke diary or text log.",
      "Exact word pairs are only seed boosts and tests; primary correction must be generated by keyboard layout mapping.",
      "Short tokens are intentionally strict: false positives are worse than missed corrections.",
      "Regex syntax is intended for ICU/NSRegularExpression."
    ],
    "target": "macOS TypeSwitcher MVP"
  },
  "name": "TypeSwitcher RU-EN conservative scoring rules",
  "protected_patterns": [
    {
      "action": "skip_auto",
      "case_insensitive": true,
      "id": "email",
      "regex": "^[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}$"
    },
    {
      "action": "skip_auto",
      "case_insensitive": true,
      "id": "url_with_scheme",
      "regex": "^(https?|ftp)://\\S+$"
    },
    {
      "action": "skip_auto",
      "case_insensitive": true,
      "id": "www_or_domain",
      "regex": "^(www\\.)?[a-z0-9-]+(\\.[a-z0-9-]+)+(/[A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*)?$"
    },
    {
      "action": "skip_auto",
      "case_insensitive": false,
      "id": "ip_address",
      "regex": "^(\\d{1,3}\\.){3}\\d{1,3}(:\\d+)?$"
    },
    {
      "action": "skip_auto",
      "case_insensitive": false,
      "id": "file_path_posix_or_relative",
      "regex": "^(~|/|\\./|\\.\\./)[^\\s]+$"
    },
    {
      "action": "skip_auto",
      "case_insensitive": false,
      "id": "file_path_windows",
      "regex": "^[A-Za-z]:\\\\[^\\s]+$"
    },
    {
      "action": "skip_auto",
      "case_insensitive": true,
      "id": "file_with_common_extension",
      "regex": "^[A-Za-z0-9._-]+\\.(swift|js|ts|tsx|jsx|py|rb|go|rs|java|kt|cpp|hpp|h|m|mm|json|yaml|yml|xml|html|css|scss|md|txt|pdf|png|jpg|jpeg|gif|zip|dmg|pkg|sql|csv|log)$"
    },
    {
      "action": "skip_auto",
      "case_insensitive": true,
      "id": "semantic_version",
      "regex": "^v?\\d+(\\.\\d+){1,3}(-[A-Za-z0-9.-]+)?$"
    },
    {
      "action": "skip_auto",
      "case_insensitive": false,
      "id": "issue_id_or_ticket",
      "regex": "^[A-Z][A-Z0-9]+-\\d+$"
    },
    {
      "action": "skip_auto",
      "case_insensitive": true,
      "id": "git_hash",
      "regex": "^[a-f0-9]{7,64}$"
    },
    {
      "action": "skip_auto",
      "case_insensitive": false,
      "id": "camel_or_pascal_identifier",
      "regex": "^[A-Za-z_$][A-Za-z0-9_$]*[A-Z][A-Za-z0-9_$]*$"
    },
    {
      "action": "skip_auto",
      "case_insensitive": false,
      "id": "snake_kebab_or_constant_identifier",
      "regex": "^[A-Za-z_$][A-Za-z0-9_$]*([-_][A-Za-z0-9_$]+)+$|^[A-Z][A-Z0-9_]{2,}$"
    },
    {
      "action": "skip_auto",
      "case_insensitive": false,
      "id": "member_or_namespace_access",
      "regex": "^[A-Za-z_$][A-Za-z0-9_$]*(::|\\.|->)[A-Za-z_$][A-Za-z0-9_$]*$"
    },
    {
      "action": "skip_auto",
      "case_insensitive": false,
      "id": "mixed_alnum_technical",
      "regex": "^(?=.*[A-Za-z])(?=.*\\d)[A-Za-z0-9._-]+$"
    },
    {
      "action": "skip_auto",
      "case_insensitive": true,
      "id": "shell_command_prefix",
      "regex": "^(git|npm|yarn|pnpm|pip|python|node|brew|ssh|scp|curl|kubectl|docker|make|swift|xcodebuild|cd|ls|cat|grep|rg|sed|awk)\\b.*$"
    },
    {
      "action": "skip_auto",
      "case_insensitive": false,
      "id": "mention_or_hashtag",
      "regex": "^[@#][A-Za-z0-9_]{2,}$"
    },
    {
      "action": "skip_auto",
      "case_insensitive": false,
      "id": "sku_or_product_code",
      "regex": "^[A-Z0-9]{2,}[-_][A-Z0-9_-]{2,}$"
    }
  ],
  "schema_version": "2.0",
