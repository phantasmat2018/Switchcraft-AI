  "decision": {
    "auto_thresholds": {
      "min_candidate_score_by_length": {
        "2": 95,
        "3": 45,
        "4": 40,
        "5_plus": 37
      },
      "min_confidence": 0.79,
      "min_delta_by_length": {
        "2": 85,
        "3": 58,
        "4": 40,
        "5": 30,
        "6_plus": 22
      },
      "original_exact_common_word_requires_extra_delta": 28,
      "phrase_start_bonus_threshold_discount": 6
    },
    "confidence": {
      "formula": "1/(1+exp(-(candidateScore-originalScore)/scale))",
      "function": "sigmoid",
      "scale": 18
    },
    "dynamic_threshold_curve": {
      "candidate_base_at_len_5": 38,
      "candidate_decay_per_shorter_len": -3,
      "candidate_floor": 14,
