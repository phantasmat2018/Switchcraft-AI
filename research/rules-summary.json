        "regex": "(цр|ер|рш|ср|пщ|цщ|ьф|дш|еф|ак|цш|еру)"
      },
      {
        "bonus_to_candidate": 12,
        "id": "invalid_russian_cluster",
        "regex": "[бвгджзклмнпрстфхцчшщ]{6,}|[аеёиоуыэюя]{4,}|[жш]ы|[чщ][яю]"
      }
    ],
    "latin_raw_suspicious_for_ru": [
      {
        "bonus_to_candidate": 12,
        "id": "contains_ru_keyboard_punctuation_letters",
        "regex": "[`\\[\\];',.]"
      },
      {
        "bonus_to_candidate": 10,
        "id": "latin_without_vowels_len_5_plus",
        "regex": "^[bcdfghjklmnpqrstvwxz]{5,}$"
      },
      {
        "bonus_to_candidate": 8,
        "id": "common_ru_wrong_layout_prefixes",
