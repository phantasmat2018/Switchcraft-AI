<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Switchcraft</AssemblyName>
    <RootNamespace>Switchcraft</RootNamespace>
    <Version>1.6.2</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Switchcraft.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Runtime\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\Switchcraft.ico" />
    <Content Include="Dictionaries\*" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />
  </ItemGroup>
</Project>
