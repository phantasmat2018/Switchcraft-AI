<Window x:Class="Switchcraft.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Switchcraft AI" Width="1180" Height="850" MinWidth="1020" MinHeight="680" WindowStartupLocation="CenterScreen" WindowStyle="None" Icon="Assets/Switchcraft.ico" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <Style x:Key="ModeChoice" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="4,0"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Chrome" Background="#11141A" BorderBrush="#363D49" BorderThickness="1" CornerRadius="9" Padding="12,14"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#243E36"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#62877B"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#62877B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#30353E" BorderThickness="1"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#15181E" BorderBrush="#272C35" BorderThickness="0,0,0,1"><DockPanel><StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center"><Image Source="{StaticResource BrandMark}" Width="22" Height="22"/><TextBlock Text="Switchcraft AI" Margin="10,0,0,0" FontSize="12" Foreground="#BDC5D0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource TitleButton}" Content="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Click="Minimize_Click" ToolTip="Згорнути" AutomationProperties.Name="Згорнути"/><Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}" Content="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Click="Maximize_Click" ToolTip="Розгорнути" AutomationProperties.Name="Розгорнути"/><Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Click="Close_Click" ToolTip="Згорнути в трей" AutomationProperties.Name="Згорнути в трей"/></StackPanel></DockPanel></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#15181E" BorderBrush="#272C35" BorderThickness="0,0,1,0"><DockPanel Margin="18,28,18,20">
    <StackPanel DockPanel.Dock="Top" Margin="12,0,0,32"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource BrandMark}" Width="38" Height="38"/><TextBlock Text="Switchcraft" FontWeight="SemiBold" FontSize="21" Margin="10,3,0,0"/></StackPanel><TextBlock Text="ВАШ РИТМ. ВАША МОВА." FontSize="9" Foreground="#6F7B89" Margin="0,15,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><Border Background="#1B2421" CornerRadius="10" Padding="14"><StackPanel><TextBlock x:Name="PrivacyTitle" Text="●  Працює локально" Foreground="{StaticResource Accent}" FontSize="12"/><TextBlock x:Name="PrivacyDescription" Text="Ваш текст залишається&#x0a;на вашому комп’ютері." Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border><TextBlock x:Name="SidebarVersion" Text="SWITCHCRAFT" FontSize="10" Foreground="#626D7D" Margin="12,20,0,0"/></StackPanel>
    <StackPanel>
     <RadioButton x:Name="HomeNav" Style="{StaticResource Nav}" GroupName="nav" Tag="HomePage" Checked="Nav_Checked" AutomationProperties.Name="Огляд" IsChecked="True"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE80F;" Margin="0,0,14,0"/><TextBlock Text="Огляд" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
     <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="ConverterPage" Checked="Nav_Checked" AutomationProperties.Name="Перетворення"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8AB;" Margin="0,0,14,0"/><TextBlock Text="Перетворення" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
     <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="LanguagesPage" Checked="Nav_Checked" AutomationProperties.Name="Мови"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xF2B7;" Margin="0,0,14,0"/><TextBlock Text="Мови" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
     <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="HotkeysPage" Checked="Nav_Checked" AutomationProperties.Name="Гарячі клавіші"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE765;" Margin="0,0,14,0"/><TextBlock Text="Гарячі клавіші" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
     <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="DictionaryPage" Checked="Nav_Checked" AutomationProperties.Name="Правила та винятки"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE82D;" Margin="0,0,14,0"/><TextBlock Text="Правила та винятки" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
     <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="ExcludedPage" Checked="Nav_Checked" AutomationProperties.Name="Винятки"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7BA;" Margin="0,0,14,0"/><TextBlock Text="Винятки" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
     <Border Height="1" Background="#282D36" Margin="12,20"/>
     <RadioButton x:Name="SettingsNav" Style="{StaticResource Nav}" GroupName="nav" Tag="SettingsPage" Checked="Nav_Checked" AutomationProperties.Name="Налаштування"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,14,0"/><TextBlock Text="Налаштування" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
    </StackPanel>
   </DockPanel></Border>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="Pages" Margin="34,28,34,32">
    <StackPanel x:Name="HomePage">
     <DockPanel Margin="0,0,0,22"><StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"><Border x:Name="StateBadge" Background="#23382E" CornerRadius="14" Padding="13,7"><TextBlock x:Name="StateLabel" Text="●  Активний" Foreground="{StaticResource Accent}" FontSize="12"/></Border></StackPanel><StackPanel><TextBlock Text="Ваш простір для тексту" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Менше перемикань. Більше зосередженості." Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel></DockPanel>
     <Border CornerRadius="18" BorderBrush="#34463E" BorderThickness="1" Padding="27,24" Margin="0,0,0,18"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#223B30" Offset="0"/><GradientStop Color="#1A2523" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="185"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="У ВАШОМУ РИТМІ" Foreground="#9FC9B4" FontSize="10" Margin="0,0,0,13"/><TextBlock FontSize="29" FontWeight="SemiBold" LineHeight="38" Text="Набирайте вільно.&#x0a;Розкладку виправимо."/><TextBlock Text="Switchcraft розпізнає мову й виправить слово,&#x0a;щойно ви натиснете пробіл." Foreground="#A8BFB4" FontSize="12" LineHeight="20" Margin="0,13,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="64" Height="66" Background="#233F32" BorderBrush="#4A6757" BorderThickness="1,1,1,5" CornerRadius="12"><TextBlock Text="EN" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="→" Foreground="{StaticResource Accent}" FontSize="24" VerticalAlignment="Center" Margin="9,0"/><Border Width="64" Height="66" Background="#29483C" BorderBrush="#537C67" BorderThickness="1,1,1,5" CornerRadius="12"><TextBlock Text="УК" Foreground="#D4E6DE" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel><TextBlock Text="ghbdsn  →  привіт" FontFamily="Consolas" FontSize="12" Foreground="#9FC9B4" HorizontalAlignment="Center" Margin="0,18,0,0"/></StackPanel></Grid></Border>
     <Border Style="{StaticResource Card}" Padding="20,17" Margin="0,0,0,18"><DockPanel><CheckBox x:Name="EnabledToggle" Style="{StaticResource Toggle}" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Enabled_Click" AutomationProperties.Name="Автоматичне виправлення"/><StackPanel><TextBlock Text="Автоматичне виправлення" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="AutoDescription" Text="Допомагає у фоновому режимі" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,20,0"/></StackPanel></DockPanel></Border>
     <UniformGrid Columns="2" Margin="0,0,0,18"><Border Style="{StaticResource Card}" Padding="18,15" Margin="0,0,6,0"><StackPanel><TextBlock x:Name="CorrectionCount" Text="0" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="CorrectionLabel" Text="виправлень за сесію" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="18,15" Margin="6,0,0,0"><StackPanel><TextBlock x:Name="LanguageCount" Text="3" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="LanguageCountLabel" Text="мови у вашому просторі" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border></UniformGrid>
     <Border Style="{StaticResource Card}" Padding="20"><StackPanel><DockPanel Margin="0,0,0,12"><TextBlock Text="Жива перевірка" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Спробуйте слово в іншій розкладці" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right"/></DockPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="QuickInput" Text="ghbdsn" TextChanged="QuickInput_Changed" AutomationProperties.Name="Текст для живої перевірки"/><TextBlock Grid.Column="1" Text="→" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#748477"/><Border Grid.Column="2" Background="#1F3028" CornerRadius="8" Padding="13,10"><TextBlock x:Name="QuickOutput" Text="привіт" Foreground="{StaticResource Accent}" VerticalAlignment="Center" FontSize="15"/></Border></Grid><TextBlock x:Name="QuickReason" Text="Англійська → Українська" Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border>
     <DockPanel Margin="0,22,0,10"><TextBlock Text="Останні виправлення" FontSize="15" FontWeight="SemiBold"/><Button x:Name="ClearHistoryButton" Content="Очистити" Click="ClearHistory_Click" HorizontalAlignment="Right" Style="{StaticResource Subtle}"/></DockPanel>
     <TextBlock x:Name="HistoryEmpty" Text="Поки що тихо. Ваші виправлення з’являться тут." Style="{StaticResource MutedText}" FontSize="12"/>
     <ItemsControl x:Name="HistoryList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#292E37" BorderThickness="0,0,0,1" Padding="0,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding Original}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Grid.Column="2" Text="→" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="3" Text="{Binding Text}" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Grid.Column="4" Text="{Binding LanguageLabel}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
    <StackPanel x:Name="ConverterPage" Visibility="Collapsed"><TextBlock Text="Перетворення тексту" Style="{StaticResource PageTitle}"/><TextBlock Text="Ручне перетворення працює за локальними правилами. Обрана нейромережа допомагає під час набору та живої перевірки." Style="{StaticResource MutedText}" Margin="0,0,0,25"/><Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,12"><TextBlock Text="Вхідний текст" Style="{StaticResource SectionTitle}"/><Button Content="Вставити" HorizontalAlignment="Right" Padding="12,6" Click="Paste_Click"/></DockPanel><TextBox x:Name="SourceText" Height="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="100000" AutomationProperties.Name="Вхідний текст"/><Grid Margin="0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="TargetLanguage" SelectedIndex="0" AutomationProperties.Name="Напрямок перетворення"><ComboBoxItem Content="Визначити автоматично" Tag="auto"/><ComboBoxItem Content="Виправити лише впевнені помилки" Tag="correct"/><ComboBoxItem Content="Перетворити на українську" Tag="uk"/><ComboBoxItem Content="Перетворити на англійську" Tag="en"/><ComboBoxItem Content="Перетворити на російську" Tag="ru"/></ComboBox><Button Grid.Column="2" Content="Перетворити  →" Style="{StaticResource Primary}" Click="Convert_Click"/></Grid><DockPanel Margin="0,0,0,12"><TextBlock Text="Результат" Style="{StaticResource SectionTitle}"/><Button Content="Копіювати" HorizontalAlignment="Right" Padding="12,6" Click="Copy_Click"/></DockPanel><TextBox x:Name="ResultText" Height="180" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Foreground="{StaticResource Accent}" AutomationProperties.Name="Результат перетворення"/><TextBlock Text="У будь-якому застосунку: виділіть текст і натисніть комбінацію перетворення. Попередній буфер обміну відновлюється після підтвердженого вставлення." Style="{StaticResource MutedText}" Margin="0,18,0,0"/></StackPanel></Border></StackPanel>
    <StackPanel x:Name="LanguagesPage" Visibility="Collapsed"><TextBlock Text="Мови та пріоритет" Style="{StaticResource PageTitle}"/><TextBlock Text="Оберіть активні мови й порядок для ручного перетворення неоднозначних слів." Style="{StaticResource MutedText}" Margin="0,0,0,25"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ваші мови" Style="{StaticResource SectionTitle}"/><ListBox x:Name="LanguageList" Height="220" DisplayMemberPath="Label" AutomationProperties.Name="Мови"/><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="↑  Вище" Click="LanguageUp_Click" Margin="0,0,10,0"/><Button Content="↓  Нижче" Click="LanguageDown_Click" Margin="0,0,10,0"/><Button Content="Увімкнути / вимкнути" Click="LanguageToggle_Click"/></StackPanel><TextBlock Text="Перша активна мова — головна: вона має пріоритет, коли неоднозначне слово перетворюється вручну. Змінюйте порядок кнопками «Вище» й «Нижче»; залиште принаймні дві активні мови. На вимкнену мову автоматичні виправлення не перетворюють; якщо вимкнено англійську, слова, набрані в англійській розкладці, однаково виправляються на активні мови. Автоматичне перемикання системної розкладки працює лише для мов, установлених у Windows. Ручне перетворення доступне для всіх трьох мов." Style="{StaticResource MutedText}" Margin="0,22,0,0"/></StackPanel></Border></StackPanel>
    <StackPanel x:Name="HotkeysPage" Visibility="Collapsed"><TextBlock Text="Гарячі клавіші" Style="{StaticResource PageTitle}"/><TextBlock Text="Натисніть на поле та введіть комбінацію з Ctrl, Alt або Shift. Delete прибирає комбінацію." Style="{StaticResource MutedText}" Margin="0,0,0,25"/><Border Style="{StaticResource Card}"><StackPanel x:Name="HotkeyFields"/></Border><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Зберегти клавіші" Style="{StaticResource Primary}" Click="SaveHotkeys_Click" Margin="0,0,12,0"/><Button Content="Відновити стандартні" Click="ResetHotkeys_Click"/></StackPanel><TextBlock x:Name="HotkeyWarning" Foreground="#EBC18D" Margin="0,18,0,0" TextWrapping="Wrap"/><TextBlock Text="Скасування працює відразу після автоматичної заміни та пробілу. Новий текст, клік або переміщення курсора завершують можливість скасування." Style="{StaticResource MutedText}" Margin="0,20,0,0"/></StackPanel>
    <StackPanel x:Name="DictionaryPage" Visibility="Collapsed"><TextBlock Text="Правила та винятки" Style="{StaticResource PageTitle}"/><TextBlock Text="Налаштуйте власні заміни й слова, яких Switchcraft не торкатиметься." Style="{StaticResource MutedText}" Margin="0,0,0,22"/><DockPanel Margin="0,0,0,14"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Імпорт" Click="Import_Click" Margin="12,0,8,0"/><Button Content="Експорт" Click="Export_Click"/></StackPanel><TextBox x:Name="RuleSearch" TextChanged="RuleSearch_Changed" ToolTip="Пошук за словом або заміною" AutomationProperties.Name="Пошук правил"/></DockPanel><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Завжди замінювати" Style="{StaticResource SectionTitle}"/><ListBox x:Name="PairsList" Height="280" DisplayMemberPath="Label" AutomationProperties.Name="Правила заміни"/><TextBox x:Name="PairSource" Margin="0,14,0,8" ToolTip="Що замінити" AutomationProperties.Name="Вихідне слово правила"/><TextBox x:Name="PairTarget" Margin="0,0,0,12" ToolTip="На що замінити" AutomationProperties.Name="Заміна правила"/><StackPanel Orientation="Horizontal"><Button Content="Додати" Style="{StaticResource Primary}" Click="AddPair_Click" Margin="0,0,8,0"/><Button Content="Видалити" Click="RemovePair_Click"/></StackPanel></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Ніколи не виправляти" Style="{StaticResource SectionTitle}"/><ListBox x:Name="NeverList" Height="280" AutomationProperties.Name="Слова-винятки"/><TextBox x:Name="NeverWord" Margin="0,14,0,12" ToolTip="Слово-виняток" AutomationProperties.Name="Слово-виняток"/><StackPanel Orientation="Horizontal"><Button Content="Додати" Style="{StaticResource Primary}" Click="AddNever_Click" Margin="0,0,8,0"/><Button Content="Видалити" Click="RemoveNever_Click"/></StackPanel><TextBlock Text="Назви, терміни та ваші улюблені скорочення." Style="{StaticResource MutedText}" FontSize="12" Margin="0,15,0,0"/></StackPanel></Border></Grid><TextBlock x:Name="RulesCount" Style="{StaticResource MutedText}"/></StackPanel>
    <StackPanel x:Name="ExcludedPage" Visibility="Collapsed"><TextBlock Text="Винятки для застосунків" Style="{StaticResource PageTitle}"/><TextBlock Text="У цих програмах автоматичне виправлення вимкнене. Ручні гарячі клавіші залишаються доступними." Style="{StaticResource MutedText}" Margin="0,0,0,25"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Не втручатися в роботу" Style="{StaticResource SectionTitle}"/><Grid><ListBox x:Name="ExcludedList" Height="240" AutomationProperties.Name="Програми-винятки"/><TextBlock x:Name="ExcludedEmpty" Text="Поки що винятків немає. Додайте програму нижче." Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><TextBlock Text="Назва виконуваного файлу" Style="{StaticResource MutedText}" Margin="0,20,0,8"/><DockPanel><Button Content="Додати" DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="AddExcluded_Click" Margin="10,0,0,0"/><TextBox x:Name="ExcludedName" AutomationProperties.Name="Назва програми-винятку"/></DockPanel><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="Обрати .exe…" Click="BrowseExcluded_Click" Margin="0,0,10,0"/><Button Content="Видалити зі списку" Click="RemoveExcluded_Click"/></StackPanel></StackPanel></Border><TextBlock Text="Поля паролів, які Windows позначає захищеними, пропускаються автоматично. Власне вікно Switchcraft не змінює текст під час набору." Style="{StaticResource MutedText}" Margin="0,22,0,0"/></StackPanel>
    <StackPanel x:Name="SettingsPage" Visibility="Collapsed"><TextBlock Text="Налаштування" Style="{StaticResource PageTitle}"/><TextBlock Text="Трохи налаштувань, щоб усе працювало по-вашому." Style="{StaticResource MutedText}" Margin="0,0,0,25"/><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
 <TextBlock Text="Як визначати мову" FontSize="18" FontWeight="SemiBold"/>
 <TextBlock Text="Оберіть спосіб для автоматичних виправлень і живої перевірки." Style="{StaticResource MutedText}" Margin="0,6,0,18"/>
 <UniformGrid Columns="2" Margin="-4,0">
  <RadioButton x:Name="LayaMode" GroupName="DetectionMode" Tag="laya" Style="{StaticResource ModeChoice}" Checked="DetectionMode_Checked" AutomationProperties.Name="Laya локально"><StackPanel><TextBlock Text="Laya · локально" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="На цьому комп’ютері" FontSize="11" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel></RadioButton>
  <RadioButton x:Name="TypeSafeMode" GroupName="DetectionMode" Tag="typesafe" Style="{StaticResource ModeChoice}" Checked="DetectionMode_Checked" AutomationProperties.Name="TypeSafe AI"><StackPanel><TextBlock Text="TypeSafe AI" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Через API" FontSize="11" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel></RadioButton>
 </UniformGrid>
 <TextBlock x:Name="AiModeDescription" Style="{StaticResource MutedText}" Margin="0,16,0,0"/>
 <StackPanel x:Name="AiOptions" Visibility="Collapsed">
  <Border Background="#202E29" BorderBrush="#385044" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,18"><TextBlock Text="Поточне слово та до 6 попередніх слів надсилаються api.typesafe.ai. Для повторної перевірки можуть додаватися до 3 наступних слів. Захищені поля й програми-винятки пропускаються; перед заміною перевіряються текст і курсор." Style="{StaticResource MutedText}" FontSize="12"/></Border>
  <TextBlock Text="Ключ API" FontWeight="SemiBold" Margin="0,0,0,8"/><PasswordBox x:Name="TypeSafeKey" MaxLength="4096" AutomationProperties.Name="Ключ API TypeSafe"/>
  <TextBlock x:Name="ApiKeyHint" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,14"/>
