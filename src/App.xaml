  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="#1C2229"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="MinHeight" Value="42"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
