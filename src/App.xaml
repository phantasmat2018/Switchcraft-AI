     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="#363F49" BorderThickness="1" CornerRadius="9">
       <Border x:Name="ArrowBox" Width="28" Height="28" Margin="0,0,7,0" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#283831" CornerRadius="6" UseLayoutRounding="True">
